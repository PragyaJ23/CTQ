# Copy this file to .env and fill in your key:  cp .env.example .env
# Get a free API key at https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here

# LLM settings
# Any chat model from https://console.groq.com/docs/models,
# e.g. openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
LLM_ENABLED=true

# Embedding model (lightweight, runs on CPU; downloads ~90MB on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Matching pipeline sizes
TOP_K_TRIALS=0
